# GigScore Backend Environment Configuration
# Prototype - synthetic data only. Not for real lending decisions.

APP_NAME="GigScore Backend"
APP_ENV=development
DATABASE_URL="sqlite:///./gigscore.db"
# For PostgreSQL (e.g. Neon / Supabase / local Postgres):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gigscore"

CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Billing & Lender Infrastructure
SCORE_CHECK_FEE_INR=30.0
CURRENCY="INR"
API_KEY_HASH_SALT="gigscore-prototype-salt-change-in-prod"
RATE_LIMIT_PER_MINUTE=60

# Consent & Mock Account Aggregator
DEFAULT_CONSENT_EXPIRY_HOURS=24
ALLOWED_CONSENT_PURPOSES="CREDIT_SCORING,LOAN_UNDERWRITING,GIG_SCORE_VERIFICATION"
DEFAULT_AA_PROVIDER="Setu_AA_Mock"

# Machine Learning & Scoring Engine
PRIMARY_MODEL_VERSION="xgboost-calibrated-v1.0"
FALLBACK_MODEL_VERSION="rule-scorecard-v1.0"
MODEL_ARTIFACT_PATH="app/ml/artifacts/gigscore_xgb_calibrated.joblib"
SCORE_MIN=300
SCORE_MAX=900
PROTOTYPE_DISCLAIMER="Prototype - synthetic data only. Not for real lending decisions."
